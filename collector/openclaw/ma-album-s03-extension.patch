+// ma-album-s03 (AC-1): bóc khoá album từ content.params của tin ảnh.
+// params là CHUỖI JSON (đo A/A-v2 05/11) nhưng phòng hờ object; group_layout_id
+// và id_in_group bắt buộc — thiếu một trong hai là ảnh đơn/không gom được
+// (undefined), các khoá tuỳ chọn có thì giữ. params hỏng → undefined, tin
+// vẫn đi tiếp.
+export function extractAlbumMeta(data: Message["data"]): ZaloAlbumMeta | undefined {
+  const content = data.content;
+  if (!content || typeof content !== "object") {
+    return undefined; // tin chữ (content string) hoặc rỗng
+  }
+  const record = content as Record<string, unknown>;
+  const rawParams = record.params;
+  let params: Record<string, unknown> | undefined;
+  if (typeof rawParams === "string" && rawParams.length > 0) {
+    try {
+      const parsed: unknown = JSON.parse(rawParams);
+      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+        params = parsed as Record<string, unknown>;
+      }
+    } catch {
+      return undefined; // params hỏng — không albumMeta
+    }
+  } else if (rawParams && typeof rawParams === "object" && !Array.isArray(rawParams)) {
+    params = rawParams as Record<string, unknown>;
+  }
+  if (!params) {
+    return undefined;
+  }
+  const gli = params.group_layout_id;
+  const iig = params.id_in_group;
+  if (gli === undefined || gli === null || iig === undefined || iig === null) {
+    return undefined;
+  }
+  const total = params.total_item_in_group;
+  const totalNum =
+    typeof total === "number" && Number.isFinite(total)
+      ? total
+      : typeof total === "string" && total !== "" && Number.isFinite(Number(total))
+        ? Number(total)
+        : undefined;
+  return {
+    group_layout_id: String(gli),
+    id_in_group: String(iig),
+    ...(totalNum !== undefined ? { total_item_in_group: totalNum } : {}),
+    ...(params.is_group_layout !== undefined
+      ? { is_group_layout: params.is_group_layout === true || params.is_group_layout === "true" }
+      : {}),
+    ...(typeof record.childnumber === "number" && Number.isFinite(record.childnumber)
+      ? { child_number: record.childnumber }
+      : {}),
+    ...(typeof data.msgType === "string" && data.msgType ? { msg_type: data.msgType } : {}),
+  };
+}
+
 export function normalizeZaloInboundMessage(
   message: Message,
   ownUserId?: string,
@@ -610,6 +665,7 @@ export function normalizeZaloInboundMessage(
     normalizedOwnUserId && quoteOwnerId && quoteOwnerId === normalizedOwnUserId,
   );
   const eventMessage = buildEventMessage(data);
+  const albumMeta = extractAlbumMeta(data);
   return {
     threadId,
     isGroup,
@@ -629,6 +685,7 @@ export function normalizeZaloInboundMessage(
     quotedOwnerId: quoteOwnerId || undefined,
     quotedBody: quotedBody || undefined,
     eventMessage,
+    ...(albumMeta ? { albumMeta } : {}),
     raw: message,
   };
 }
