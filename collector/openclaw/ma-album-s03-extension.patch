@@ -0,0 +1,116 @@
+import { describe, expect, it, vi } from "vitest";
+// khuôn zalo-js.listener.test.ts: mock zca-client để không kéo nguyên thư viện
+// nguồn (tough-cookie v.v.) vào vitest
+const createZalo = vi.hoisted(() => vi.fn());
+vi.mock("./zca-client.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./zca-client.js")>()),
+  createZalo,
+}));
+import { ThreadType } from "./zca-constants.js";
+import { extractAlbumMeta, normalizeZaloInboundMessage } from "./zalo-js.js";
+import type { Message } from "./zca-client.js";
+
+// ma-album-s03 (E1/AC-1): extractAlbumMeta đúng các tập khoá đã thấy (đo
+// A/A-v2 05/11: đủ khoá · thiếu total · thiếu is_group_layout · params
+// object phòng hờ · params hỏng · tin chữ · ảnh đơn không khoá), và
+// normalizeZaloInboundMessage GIỮ albumMeta khi có, KHÔNG thêm khi không.
+
+const paramsDayDu = JSON.stringify({
+  id_in_group: "123",
+  is_group_layout: true,
+  width: 1200,
+  height: 800,
+  group_layout_id: "g-456",
+  total_item_in_group: 3,
+  hd: true,
+  convertible: false,
+});
+const tinAnh = (params: unknown, childnumber?: number, msgType = "chat.photo"): Message => ({
+  type: ThreadType.Group,
+  data: {
+    msgId: "m1",
+    cliMsgId: "c1",
+    uidFrom: "100",
+    idTo: "200",
+    dName: "S",
+    content: {
+      title: "",
+      description: "",
+      href: "https://cdn.example/anh.jpg",
+      thumb: "https://cdn.example/thumb.jpg",
+      childnumber: childnumber ?? 1,
+      action: "action",
+      params,
+      type: "photo",
+    },
+    msgType,
+    ts: "1793328800000",
+  } as unknown as Message["data"],
+});
+
+describe("extractAlbumMeta — các tập khoá đã thấy", () => {
+  it("đủ khoá: giữ cả nhóm tuỳ chọn, bỏ thuộc tính ảnh", () => {
+    expect(extractAlbumMeta(tinAnh(paramsDayDu, 2).data)).toEqual({
+      group_layout_id: "g-456",
+      id_in_group: "123",
+      total_item_in_group: 3,
+      is_group_layout: true,
+      child_number: 2,
+      msg_type: "chat.photo",
+    });
+  });
+  it("thiếu total_item_in_group (11/70 lần gặp 05/11): vẫn nhận, không có khoá đó", () => {
+    const p = JSON.stringify({ id_in_group: "7", group_layout_id: "g-1" });
+    const m = extractAlbumMeta(tinAnh(p).data);
+    expect(m?.group_layout_id).toBe("g-1");
+    expect(m?.id_in_group).toBe("7");
+    expect(m?.total_item_in_group).toBeUndefined();
+    expect(m?.is_group_layout).toBeUndefined();
+  });
+  it("is_group_layout dạng chuỗi 'true': chuẩn hoá boolean", () => {
+    const p = JSON.stringify({ id_in_group: "7", group_layout_id: "g-1", is_group_layout: "true" });
+    expect(extractAlbumMeta(tinAnh(p).data)?.is_group_layout).toBe(true);
+  });
+  it("params là object (phòng hờ): vẫn bóc được", () => {
+    const m = extractAlbumMeta(tinAnh({ id_in_group: 9, group_layout_id: 77 } as unknown as string, undefined).data);
+    expect(m).toEqual({ group_layout_id: "77", id_in_group: "9", child_number: 1, msg_type: "chat.photo" });
+  });
+  it("params hỏng (chuỗi không JSON): undefined — tin vẫn đi tiếp", () => {
+    expect(extractAlbumMeta(tinAnh("{hong-json").data)).toBeUndefined();
+  });
+  it("thiếu group_layout_id hoặc id_in_group: undefined (ảnh đơn)", () => {
+    expect(extractAlbumMeta(tinAnh(JSON.stringify({ width: 1 })).data)).toBeUndefined();
+    expect(extractAlbumMeta(tinAnh(JSON.stringify({ group_layout_id: "g" })).data)).toBeUndefined();
+  });
+  it("content là chuỗi (tin chữ): undefined", () => {
+    const msg: Message = {
+      type: ThreadType.User,
+      data: { msgId: "m", cliMsgId: "c", uidFrom: "1", idTo: "2", content: "xin chào", ts: "1" } as unknown as Message["data"],
+    };
+    expect(extractAlbumMeta(msg.data)).toBeUndefined();
+  });
+});
+
+describe("normalizeZaloInboundMessage — albumMeta (AC-1)", () => {
+  it("tin ảnh có khoá: message.albumMeta giữ, mọi trường cũ nguyên", () => {
+    const m = normalizeZaloInboundMessage(tinAnh(paramsDayDu, 2), "999");
+    expect(m?.albumMeta).toBeDefined();
+    expect(m?.msgId).toBe("m1");
+    expect(m?.threadId).toBe("200");
+    expect(m?.content).toContain("anh.jpg");
+  });
+  it("tin chữ: GIỐNG HỆT bản trước vá — không có khoá albumMeta", () => {
+    const msg: Message = {
+      type: ThreadType.User,
+      data: { msgId: "m", cliMsgId: "c", uidFrom: "1", idTo: "2", dName: "S", content: "bán nhà", ts: "1793328800000" } as unknown as Message["data"],
+    };
+    const m = normalizeZaloInboundMessage(msg, "999");
+    expect(m).toBeDefined();
+    expect("albumMeta" in (m ?? {})).toBe(false);
+    expect(m?.content).toBe("bán nhà");
+  });
+  it("ảnh đơn không khoá: không có albumMeta", () => {
+    const m = normalizeZaloInboundMessage(tinAnh(JSON.stringify({ width: 5 })), "999");
+    expect("albumMeta" in (m ?? {})).toBe(false);
+  });
+});
