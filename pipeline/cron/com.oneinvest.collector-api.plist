<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.collector-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/collector/scripts/api-launchd.sh</string>
  </array>
  <!-- Collector API :9210 (ADR-0006) — KeepAlive tự lên lại khi chết.
       ExitTimeOut 60 > deadline graceful-shutdown 45s: SIGTERM phải để
       tiến trình đóng HTTP + lặp flush hết buffer thành snapshot RỒI tự
       thoát, launchd mới được SIGKILL — không mất tin đã ack 202. -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ExitTimeOut</key><integer>60</integer>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/launchd-collector-api.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/launchd-collector-api.log</string>
</dict>
</plist>
