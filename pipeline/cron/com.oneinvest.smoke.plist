<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.smoke</string>
  <key>ProgramArguments</key>
  <array>
    <string>bash</string>
    <string>__ROOT__/scripts/smoke-daily.sh</string>
  </array>
  <!-- 20:00 hằng ngày - smoke tu CONDUCT_WINDOW=off -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/launchd-smoke.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/launchd-smoke.log</string>
</dict>
</plist>
