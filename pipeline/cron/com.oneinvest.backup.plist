<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>bash</string>
    <string>__ROOT__/pipeline/scripts/backup.sh</string>
  </array>
  <!-- Chu nhat 21:00 - sau collector; env BACKUP_DIR/BACKUP_PASS do install
       ghi vao plist khi co (script doc env, khong hardcode pass) -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/launchd-backup.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/launchd-backup.log</string>
</dict>
</plist>
