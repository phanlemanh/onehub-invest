<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.airdna-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/airdna-daily.sh</string>
  </array>
  <!-- CCP activity window 19-23h — chạy đầu cửa sổ, jitter + cap trong collector -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/airdna-daily.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/airdna-daily.log</string>
</dict>
</plist>
