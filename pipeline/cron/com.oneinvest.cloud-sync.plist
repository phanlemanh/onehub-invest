<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.cloud-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/cloud-sync.sh</string>
  </array>
  <!-- C4: outbound-only sync lên Supabase mỗi 15 phút -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/cloud-sync.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/cloud-sync.log</string>
</dict>
</plist>
