		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/manhphan/dev/onehub-invest/pipeline/logs/s08-weekly.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/manhphan/dev/onehub-invest/pipeline/logs/s08-weekly.log</string>
</dict>
</plist>
