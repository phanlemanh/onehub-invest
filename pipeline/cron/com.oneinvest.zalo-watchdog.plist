<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.zalo-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/zalo-watchdog.sh</string>
  </array>
  <!-- mỗi 300s: guard 5 lớp lockdown Zalo (Phương án B) -->
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/zalo-watchdog-run.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/zalo-watchdog-run.log</string>
</dict>
</plist>
