<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.ops-apply</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/pipeline/ops-apply.mjs</string>
  </array>
  <!-- TV4 so-lenh-bo-ap (ADR-0015 §2): máy thu kéo lệnh đã duyệt mỗi 60 giây, chỉ gọi ra ngoài.
       Phanh: tệp ~/.oneinvest/ops-apply.dung. __NODE__ thay lúc cài bằng `command -v node` (launchd PATH tối giản,
       so-lenh-sua-sau-tv4): dòng cài duy nhất ở docs/ops/runtime-map.md. -->
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/ops-apply.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/ops-apply.log</string>
</dict>
</plist>
