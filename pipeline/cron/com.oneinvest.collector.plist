<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oneinvest.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>bash</string>
    <string>__ROOT__/pipeline/scripts/weekly-with-jitter.sh</string>
    <string>hanoi</string>
  </array>
  <!-- Chủ nhật 19:30 (trong cửa sổ CCP 19-23; script tự jitter ≤30 phút) -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/pipeline/logs/launchd-collector.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/pipeline/logs/launchd-collector.log</string>
</dict>
</plist>
