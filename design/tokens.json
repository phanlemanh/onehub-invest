{
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "0.625rem"
    },
    "sm": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 0.6)"
    },
    "md": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 0.8)"
    },
    "lg": {
      "$type": "dimension",
      "$value": "{radius.base}"
    },
    "xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 1.4)"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 1.8)"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 2.2)"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "calc(var(--radius) * 2.6)"
    }
  },
