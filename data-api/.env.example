# PostgreSQL connection (Supabase pooler, local, or Docker)
DATABASE_URL=  # postgres connection string (see README)

# API port
PORT=3001

# API keys (comma-separated). Required unless NODE_ENV=development or NODE_ENV=test (not on Vercel):
# without keys elsewhere, data routes answer 503 AUTH_NOT_CONFIGURED and the Node server refuses to start.
DATA_API_KEYS=

# Public URL for OpenAPI servers (optional)
PUBLIC_URL=
