"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"_acceptance/do-hieu-qua-hang-ngay/evidence/E11-step2.png\",\"title\":\"Ảnh chứng E11-step1.png và E11-step2.png giống hệt nhau từng byte, chụp bài thật chưa che người bán thay vì bài bịa\",\"severity\":\"high\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Hai ảnh chứng của màn soát giống hệt nhau và hiện bài thật kèm tên, mã người đăng trên kho đã công khai. Người xem chứng cứ không thấy được điều đã hứa và định danh người bán bị phơi trong ảnh.\",\"can_cu\":\"Ảnh chỉ là bằng chứng chứ không ảnh hưởng người dùng cuối, nhưng đã nằm trên kho công khai; chụp lại rẻ và không mất dữ liệu.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"app/src/lib/do-hang-ngay.ts\",\"title\":\"Nhãn lát «Phường/xã» lệch thuật ngữ chuẩn «Phường» của CONTEXT.md\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Màn đo hằng ngày gọi lát này là «Phường/xã» trong khi nơi khác của sản phẩm chỉ gọi «Phường». Người dùng có thể thấy hai tên cho một khái niệm nhưng vẫn hiểu được.\",\"can_cu\":\"Chỉ là khác chữ nhỏ, không mất dữ liệu và không gây hiểu nhầm; sửa sau rất rẻ.\",\"proposal\":\"wont-fix\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"app/src/components/ops/quality/do-hang-ngay.tsx\",\"title\":\"Trạng thái trống «Lát này chưa có số» không có hành động; chỉ bảo người dùng tự chọn «Tổng» bằng chữ\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Khi một lát chưa có số, màn chỉ nói người dùng tự chọn «Tổng» chứ không có nút bấm sẵn. Người vận hành phải tự chuyển lát.\",\"can_cu\":\"Chỉ bất tiện nhỏ, người dùng tự chọn lại được ngay, không mất dữ liệu.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"pipeline/do-hang-ngay.mjs\",\"title\":\"oThe bỏ qua nhãn «Không suy ra được» của người và lấy nháp máy, nên thẻ người đã soát bị xếp sai ô ở lát Toà và Khu đô thị\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":true,\"acRef\":\"AC-7\",\"plain\":\"\",\"can_cu\":\"\",\"proposal\":\"\",\"khongBacBo\":false,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"pipeline/do-hang-ngay.mjs\",\"title\":\"DELETE theo ngày đo vẫn giữ vế OR theo giờ chạy: lần chạy hằng ngày xoá lặng lẽ các dòng do1-* của ngày khác đã ghi bù trong cùng ngày\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu chạy bù số đo của một ngày cũ rồi chạy đo thường, số của ngày bù có thể bị xoá âm thầm. Người vận hành thấy thiếu số ngày đó mà không có cảnh báo.\",\"can_cu\":\"Chỉ xảy ra khi ghi bù, số đo chạy lại được từ dữ liệu gốc nên không mất vĩnh viễn.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"pipeline/scripts/do-hang-ngay.test.mjs\",\"title\":\"Hình dạng 4 (khẳng định âm một mình, không đối chứng dương): «AC-4 qua bộ ghi» chỉ đo bo = 0, mà fixture dựng sao cho bo luôn bằng 0\",\"severity\":\"high\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Phép thử ước bỏ sót chưa có ca thật để chứng minh máy đếm đúng khi bỏ sót. Số bỏ sót trên màn có thể sai mà bài thử vẫn xanh.\",\"can_cu\":\"Nguy cơ là bỏ sót lệch mà không ai biết, nhưng chưa có bằng chứng số sai; thêm ca thử sau rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"pipeline/scripts/do-hang-ngay.test.mjs\",\"title\":\"Hình dạng 2 (fixture viết tay đúng khuôn bên đọc): AC-7 dựng đơn vị tay, có building_key mà bộ ghi không bao giờ sinh\",\"severity\":\"high\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Phép thử lát Toà chạy trên dữ liệu dựng tay mà máy thật không tạo ra, nên chưa chứng minh lát Toà có số đúng trên dữ liệu thật.\",\"can_cu\":\"Rủi ro là lát Toà trống hoặc lệch mà không bị bắt; sửa bài thử không ảnh hưởng người dùng.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"app/tests/do-hang-ngay-quality.test.tsx\",\"title\":\"Hình dạng 2 (fixture viết tay): trạng thái «đã lập mốc» của AC-8 nay render từ đối tượng dựng tay thay vì dòng skip của bộ ghi\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Trạng thái «đã lập mốc» trên màn mới được thử với dữ liệu dựng tay, chưa thử với dòng thật do máy ghi ra.\",\"can_cu\":\"Nếu lệch khuôn thì màn hiện sai trạng thái nhưng không mất dữ liệu; sửa bài thử rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-07T13:08:24Z\",\"sha\":\"4d638b9a6c144d8bdffe6286d526a14b3c98220d\",\"round\":2,\"kind\":\"finding\",\"file\":\"app/tests/do-hang-ngay-quality.test.tsx\",\"title\":\"Hình dạng 3 (chuỗi có mặt thay cho quan hệ): «Đổi khoá tách riêng» chỉ kiểm tiêu đề cột, không có số đổi khoá nào đi vào bảng\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài thử chưa chứng minh số đổi khoá nằm đúng cột trên màn chuyển bậc; nếu dồn nhầm cột, người xem sẽ đọc sai.\",\"can_cu\":\"Chưa có bằng chứng số hiện sai; chỉ là kiểm chưa chặt, sửa sau rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
