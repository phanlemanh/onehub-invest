    {
      "file": "agent/src/agents/judge-entity.ts",
      "title": "khoaDuong: kiểm «ô chỉ có từ vị trí» chỉ nhận dạng có dấu, trong khi regex cắt cụm vị trí nhận cả dạng không dấu",
      "severity": "low",
      "plain": "Khi ô đường chỉ ghi mỗi từ chỉ vị trí viết không dấu (ví dụ «Hem», «Ngo»), hệ thống vẫn coi là đường khác và có thể loại oan hai tin cùng một căn.",
      "can_cu": "Hậu quả nhẹ vì chỉ ảnh hưởng ô đường chỉ ghi mỗi từ vị trí không dấu, hiếm gặp, và người duyệt vẫn thấy thẻ để tự quyết; sửa sau không đắt.",
      "proposal": "known-limits",
      "fromRound": 1,
      "tepDoi": false
    },
    {
      "file": "agent/src/agents/judge-entity.ts",
      "title": "Ngoại lệ «tháng <số>» chỉ bắt chữ có dấu: đường đánh số viết không dấu bị ghép nhầm thành Khớp",
      "severity": "medium",
      "plain": "Hai đường đánh số khác nhau viết không dấu (ví dụ «30 thang 4» và «2 thang 4») bị báo là cùng đường, nên hai căn ở hai đường khác nhau có thể bị ghép nhầm thành một căn mà không có cảnh báo.",
      "can_cu": "Nặng vừa vì có thể ghép nhầm hai căn khác nhau mà không báo, người dùng khó tự phát hiện; nên làm thành việc riêng có ca thử đi kèm.",
      "proposal": "new-contract",
      "fromRound": 1,
      "tepDoi": false
    },
    {
      "file": "agent/src/agents/judge-entity.ts",
      "title": "Kiểm «từ vị trí trần» chỉ có dạng có dấu: 'Ngo'/'Hem'/'Ngach'/'Kiet' trần vẫn sinh khoá và ra Lệch",
      "severity": "low",
      "plain": "Ô đường chỉ có từ vị trí viết không dấu bị báo «Lệch» thay vì «Thiếu», nên hai tin cùng căn có thể bị loại oan vì lý do đường khác.",
      "can_cu": "Hậu quả nhẹ và hiếm, thẻ vẫn hiện cho người duyệt xem lại; ghi lại làm han chế đã biết là đủ.",
      "proposal": "known-limits",
      "fromRound": 1,
      "tepDoi": false
    },
