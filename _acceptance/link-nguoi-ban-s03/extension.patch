+      changed_profiles: Object.fromEntries(mas.map((m) => [`${m}_0`, { userId: m, username: `u${m}` }])),
+    });
+    const bodys: string[] = [];
+    const deps = taoDeps(undefined, fs, 2);
+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    (deps as unknown as { fetchImpl: unknown }).fetchImpl = (async (_u: string, init?: RequestInit) => {
