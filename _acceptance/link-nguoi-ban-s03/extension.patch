+  loiMoiNgay: 30,
+  khungBatDauGio: 1, // 01:00 giờ VN
+  khungKetThucGio: 5, // 05:00 giờ VN
+  treMs: 15_000,
+  doiChung: 2,
+} as const;
+
+const TEN = {
+  yeuCau: "yeu-cau.json",
+  yeuCauDaXu: "yeu-cau.da-xu.json",
+  chan: "chan.txt",
+  moc60s: "moc-60s.txt",
+  demNgay: (ngay: string) => `dem-${ngay}.txt`,
+  daThu: "da-thu.txt",
+  dieuKhieuLuotLon: "luot-lon.txt",
+  spool: "spool-ho-so.jsonl",
+} as const;
+
+function ngayVN(d: Date): string {
+  // Giờ VN (UTC+7) — khung 01:00–05:00 tính theo giờ VN bất kể múi máy.
+  return new Date(d.getTime() + 7 * 3600_000).toISOString().slice(0, 10);
+}
+
+function gioVN(d: Date): number {
+  return new Date(d.getTime() + 7 * 3600_000).getUTCHours();
+}
+
+export function trongKhung(d: Date): boolean {
+  const h = gioVN(d);
+  return h >= TRAN.khungBatDauGio && h < TRAN.khungKetThucGio;
+}
+
+/** Bóc hậu tố `_0` thư viện tự thêm vào khoá hồ sơ (đo 0611) — khớp mã gửi đi. */
+export function boHauSo(khoa: string): string {
+  return khoa.endsWith("_0") ? khoa.slice(0, -2) : khoa;
+}
+
+/**
+ * Phân loại một lời trả về theo AC-1. THUẦN — test gọi trực tiếp.
+ * Chỉ giữ userId + username của changed_profiles; bỏ mọi trường khác ngay.
+ */
+export function phanLoai(
+  resp: {
+    changed_profiles?: Record<string, { userId?: string; username?: string }>;
+    unchanged_profiles?: Record<string, unknown>;
+  },
+  maGui: string[],
+): LookupKetQua[] {
+  const doiChieu = new Map<string, LookupKetQua>();
+  for (const ma of maGui) doiChieu.set(ma, { ma, loai: "khong-tim-thay", username: "" });
+  if (resp.changed_profiles) {
+    for (const [khoa, prof] of Object.entries(resp.changed_profiles)) {
+      const ma = boHauSo(khoa);
+      const kq = doiChieu.get(ma);
+      if (!kq) continue; // khoá lạ — không phải mã mình gửi (đối chứng AC-3 tự soi)
+      // AC-1: kết quả ghép theo userId của hồ sơ trả về
+      if (typeof prof?.userId === "string" && prof.userId && prof.userId !== ma) {
+        kq.loai = "khong-ro";
+        continue;
+      }
+      if (typeof prof?.username === "string" && prof.username) {
+        kq.loai = "co-username";
+        kq.username = prof.username; // chỉ giữ username — bỏ SĐT/tên/ảnh/ngày sinh
+      } else {
+        kq.loai = "khong-username";
+      }
+    }
+  }
+  if (resp.unchanged_profiles) {
+    for (const khoa of Object.keys(resp.unchanged_profiles)) {
+      const kq = doiChieu.get(boHauSo(khoa));
+      // 0711-37(c): nhóm không đổi = KHÔNG RÕ — không phải khong-username (rút nhầm username đúng)
+      if (kq && kq.loai === "khong-tim-thay") kq.loai = "khong-ro";
+    }
+  }
+  return [...doiChieu.values()];
+}
+
+function maLoiChanTuError(e: unknown): { ma: string; so: string } {
+  const msg = e instanceof Error ? e.message : String(e);
+  const soKhop = msg.match(/\b(\d{3})\b/);
+  const so = soKhop?.[1] ?? "";
+  if (/\b401\b/.test(msg)) return { ma: "http-401", so: "401" };
+  if (/\b429\b/.test(msg)) return { ma: "http-429", so: "429" };
+  if (/rate|too many|throttle/i.test(msg)) return { ma: "rate-limit", so };
+  // 0711-37(f): nhánh hết 15 giây ném Error("het-15s") nội bộ — khớp trước timeout chung
+  if (/^het-15s$/.test(msg) || /timeout|timed? out|ETIMEDOUT/i.test(msg)) return { ma: "het-15s", so };
+  return { ma: "loi-la", so };
+}
+
+/**
+ * Một vòng chạy của bộ tra (một tick hẹn giờ). Trả bản ghi để monitor in số
+ * đếm — không in nội dung hồ sơ. Mọi đường dừng đều ghi tệp chặn đúng mã.
+ */
+export async function chayVong(deps: LookupDeps): Promise<VongChay> {
+  const demRong: LookupDem = {
+    "co-username": 0,
+    "khong-username": 0,
+    "khong-ro": 0,
+    "khong-tim-thay": 0,
+  };
+  const bayLoi = (chan: string) => ({ loi_goi: 0, dem: { ...demRong }, doi_chung: [], chan });
+  const duong = (f: string) => `${deps.dir}/${f}`;
+
+  // Tệp chặn còn đó → 0 lời gọi tới khi người xoá (AC-2).
+  if (await deps.tonTai(duong(TEN.chan))) return bayLoi("chan-con");
+
+  // 0711-37(a): phát lại spool trước khi xử lý yêu cầu mới — dòng 401 cũ
+  // được gửi lại với Authorization; thất bại thì giữ nguyên không mất.
+  await phatLaiSpool(deps);
+
+  // Chỉ chạy trong khung 01:00–05:00 giờ VN (AC-1).
+  if (!trongKhung(deps.now())) return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+
+  // Tệp yêu cầu: không có / rỗng / sai khuôn → 0 lời gọi (AC-1).
+  const duongYeuCau = duong(TEN.yeuCau);
+  let yeuCau: { mas: string[]; doi_chung: string[] };
+  try {
+    const raw = await deps.docFile(duongYeuCau);
+    if (!raw || !raw.trim()) return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+    const parsed = JSON.parse(raw) as { mas?: unknown; doi_chung?: unknown };
+    if (
+      !Array.isArray(parsed.mas) ||
+      parsed.mas.length === 0 ||
+      !parsed.mas.every((m) => typeof m === "string" && /^\d+$/.test(m))
+    ) {
+      await deps.ghiFile(duong(TEN.chan), "sai-khuon-yeu-cau");
+      return bayLoi("sai-khuon-yeu-cau");
+    }
+    yeuCau = { mas: parsed.mas as string[], doi_chung: (parsed.doi_chung as string[]) ?? [] };
+  } catch {
+    await deps.ghiFile(duong(TEN.chan), "sai-khuon-yeu-cau");
+    return bayLoi("sai-khuon-yeu-cau");
+  }
+
+  // API của bộ nghe tin ĐANG NỐI — không có → tệp chặn khong-co-phien, 0 lời (AC-1).
+  const api = deps.layApi();
+  if (!api) {
+    // S4-2(1) điểm dừng an toàn (AC-2): từng gọi lời trong 30′ mà giờ hết
+    // phiên → tệp chặn listener-dong-sau-goi (+ phán dung-goi-Manh ở
+    // khoiDongBoTra), không gọi tiếp; chưa từng gọi → khong-co-phien như cũ.
+    const mocCu = Number((await deps.docFile(duong(TEN.moc60s))) ?? "0");
+    const trong30 = Number.isFinite(mocCu) && mocCu > 0 && deps.now().getTime() - mocCu <= 30 * 60_000;
+    const chanAnToan = trong30 ? "listener-dong-sau-goi" : "khong-co-phien";
+    await deps.ghiFile(duong(TEN.chan), chanAnToan);
+    return bayLoi(chanAnToan);
+  }
+
+  // Trần ngày ≤30 lời (mốc đĩa theo ngày VN) — AC-1.
+  const ngay = ngayVN(deps.now());
+  const demNgay = Number((await deps.docFile(duong(TEN.demNgay(ngay)))) ?? "0");
+  if (!(Number.isFinite(demNgay) && demNgay < TRAN.loiMoiNgay)) {
+    return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+  }
+
+  // Lượt thử mặc định: đúng một lời, có dấu đã thử (AC-3). Lượt lớn chỉ khi
+  // NGƯỜI đặt giá trị trong tệp điều khiển riêng (tệp có nội dung — không mặc định).
+  const textLuotLon = await deps.docFile(duong(TEN.dieuKhieuLuotLon));
+  const luotLon = !!(textLuotLon && textLuotLon.trim());
+  if (!luotLon && (await deps.tonTai(duong(TEN.daThu)))) {
+    return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+  }
+
+  // Trần ≤20 mã một lời (AC-1).
+  const mas = yeuCau.mas.slice(0, TRAN.maMoiLoi);
+  const doiChungYeuCau = yeuCau.doi_chung.slice(0, TRAN.doiChung);
+  // MỞ LẠI claudedp-0611-6: mã đối chứng sai khuôn (không toàn chữ số) →
+  // sai-khuon-yeu-cau, KHÔNG đốt lời thử duy nhất
+  if (doiChungYeuCau.some((ma) => !/^\d{1,32}$/.test(ma))) {
+    await deps.ghiFile(duong(TEN.chan), "sai-khuon-yeu-cau");
+    return bayLoi("sai-khuon-yeu-cau");
+  }
+  // MỞ LẠI: MỘT lời gồm cả mã người bán lẫn mã đối chứng (khử trùng) —
+  // trước đây gọi getUserInfo(mas) rồi tìm đối chứng trong kết quả không
+  // chứa nó → luôn khong-tim-thay → chặn nhầm khac-khong-gian-ma.
+  const masGoi = [...new Set([...mas, ...doiChungYeuCau])];
+
+  // Cách lời trước ≥60 giây kể cả qua khởi động lại listener — mốc đĩa (AC-1).
+  const mocCu = Number((await deps.docFile(duong(TEN.moc60s))) ?? "0");
+  const hienTai = deps.now().getTime();
+  if (Number.isFinite(mocCu) && mocCu > 0 && hienTai - mocCu < TRAN.giayGiuaLoi * 1000) {
+    return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+  }
+
+  // Kiểm hai tệp (chặn + yêu cầu) NGAY TRƯỚC lời — đặt tệp chặn hoặc xoá tệp
+  // yêu cầu giữa lượt làm các lời còn lại bằng 0, KHÔNG đốt mốc/dấu đã-thử (AC-9).
+  if ((await deps.tonTai(duong(TEN.chan))) || !(await deps.tonTai(duongYeuCau))) {
+    return { loi_goi: 0, dem: { ...demRong }, doi_chung: [] };
+  }
+
+  // GHI mốc TRƯỚC lời gọi — lời treo vẫn tính là một lời (AC-1 tính lời, không thử lại).
+  await deps.ghiFile(duong(TEN.moc60s), String(hienTai));
+  await deps.ghiFile(duong(TEN.demNgay(ngay)), String(demNgay + 1));
+  if (!luotLon) await deps.ghiFile(duong(TEN.daThu), new Date(hienTai).toISOString());
+
+  let ketQua: LookupKetQua[];
+  try {
+    // Lời gọi MỚI duy nhất của tính năng này (AC-4): getUserInfo với mảng mã.
+    // 15 giây không trả → coi như lỗi, kết quả muộn bị bỏ (AC-2).
+    const resp = await Promise.race([
+      api.getUserInfo(masGoi) as Promise<unknown>,
+      deps.treMs(TRAN.treMs).then(() => {
+        throw new Error("het-15s");
+      }),
+    ]);
+    ketQua = phanLoai((resp ?? {}) as Parameters<typeof phanLoai>[0], masGoi);
+  } catch (e) {
+    // Dừng cả lượt, không thử lại; tệp chặn chỉ chứa mã lý do + số (AC-2).
+    const { ma, so } = maLoiChanTuError(e);
+    await deps.ghiFile(duong(TEN.chan), so ? `${ma} ${so}` : ma);
+    return bayLoi(ma);
+  }
+
+  for (const kq of ketQua) demRong[kq.loai]++;
+
+  // Đối chứng (AC-3): 2 mã người đã gửi tin 24h qua; sai không gian mã → chặn.
+  const doiChung = doiChungYeuCau.map((ma) => {
+    const kq = ketQua.find((k) => k.ma === ma);
+    return { ma, loai: kq?.loai ?? ("khong-tim-thay" as LookupLoai) };
+  });
+  if (doiChung.some((d) => d.loai === "khong-tim-thay" || d.loai === "khong-ro")) {
+    await deps.ghiFile(duong(TEN.chan), "khac-khong-gian-ma");
+    return { loi_goi: 1, dem: { ...demRong }, doi_chung: doiChung, chan: "khac-khong-gian-ma" };
+  }
+
+  // Tệp yêu cầu xử MỘT lần — đổi tên đã-xử (AC-3).
+  await deps.doiTen(duongYeuCau, duong(TEN.yeuCauDaXu));
+
+  // Kết quả → API collector thành snapshot hồ sơ S03 (AC-5); collector không
+  // nhận thì vào spool, không mất.
+  const tapMas = new Set(mas);
+  const dong = ketQua.filter((kq) => tapMas.has(kq.ma)).map((kq) => ({
+    ma_tai_khoan: kq.ma,
+    username: kq.username,
+    loai: kq.loai,
+    lay_luc: new Date(hienTai).toISOString(),
+  }));
+  await guiCollector(deps, dong);
+
+  return { loi_goi: 1, dem: { ...demRong }, doi_chung: doiChung };
+}
+
+// 0711-37(a): Authorization BẮT BUỘC (collector fail-closed 401 khi thiếu);
+// khoá từ env S03_COLLECTOR_KEY; spool PHÁT LẠI đầu mỗi vòng (không nằm mãi).
+async function guiCollector(deps: LookupDeps, dong: Array<Record<string, string>>): Promise<void> {
+  if (deps.collectorUrl) {
+    const key = process.env.S03_COLLECTOR_KEY?.trim() ?? "";
+    try {
+      const r = await Promise.race([
+      deps.fetchImpl(deps.collectorUrl, {
+        method: "POST",
+        headers: { "content-type": "application/json", authorization: `Bearer ${key}` },
+        body: JSON.stringify({ loai: "ho-so", dong }),
+      }),
+      // S4-2(2): fetch collector treo phải thả vòng (chống chồng, spool kịp)
+      deps.treMs(TRAN.collectorTreMs).then(() => {
+        throw new Error("het-thoi-gian-collector");
+      }),
+    ]);
+      if (r.ok) return;
+    } catch {
+      // rơi xuống spool
+    }
+  }
+  await deps.noiFile(
+    `${deps.dir}/${TEN.spool}`,
+    dong.map((d) => JSON.stringify(d)).join("\n") + "\n",
+  );
+}
+
+// 0711-37(a): phát lại spool — đọc các dòng chưa gửi, thử lại collector,
+// chỉ XOÁ dòng đã gửi thành công (ghi lại phần còn lại nguyên thứ tự).
+export async function phatLaiSpool(deps: LookupDeps): Promise<number> {
+  const duongSpool = `${deps.dir}/${TEN.spool}`;
+  const text = (await deps.docFile(duongSpool)) ?? "";
+  if (!text.trim()) return 0;
+  const dong = text.trim().split("\n").filter(Boolean).map((l) => JSON.parse(l));
+  if (!deps.collectorUrl || dong.length === 0) return 0;
+  const key = process.env.S03_COLLECTOR_KEY?.trim() ?? "";
+  try {
+    const r = await Promise.race([
+      deps.fetchImpl(deps.collectorUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json", authorization: `Bearer ${key}` },
+      body: JSON.stringify({ loai: "ho-so", dong }),
+    }),
+      // S4-2(2): fetch collector treo phải thả vòng (chống chồng, spool kịp)
+      deps.treMs(TRAN.collectorTreMs).then(() => {
+        throw new Error("het-thoi-gian-collector");
+      }),
+    ]);
+    if (r.ok) {
+      await deps.ghiFile(duongSpool, "");
+      return dong.length;
+    }
+  } catch {
+    // vẫn giữ spool
+  }
+  return 0;
+}
+
+/**
+ * Vòng hẹn giờ DUY NHẤT của bộ tra (AC-1) — monitor gọi một lần khi extension
+ * khởi động; listener khởi động lại không sinh vòng thứ hai.
+ */
+export function dungBoHenGio(
+  deps: LookupDeps,
+  log: (line: string) => void,
+  chuKyMs = 60_000,
+): () => void {
+  let dung = false;
+  let dangChay = false;
+  const vong = setInterval(() => {
+    if (dung || dangChay) return;
+    dangChay = true;
+    void chayVong(deps)
+      .then((v) => {
+        if (v.loi_goi > 0 || v.chan) {
+          // Chỉ in số đếm + đối chứng + mã chặn — không in hồ sơ (AC-3).
+          log(
+            `[seller-lookup] loi_goi=${v.loi_goi} co-username=${v.dem["co-username"]} khong-username=${v.dem["khong-username"]} khong-ro=${v.dem["khong-ro"]} khong-tim-thay=${v.dem["khong-tim-thay"]}` +
+              (v.doi_chung.length
+                ? ` doi_chung=${v.doi_chung.map((d) => `${d.loai}`).join(",")}`
+                : "") +
+              (v.chan ? ` chan=${v.chan}` : ""),
+          );
+        }
+      })
+      .catch((e) => {
+        // Bộ tra không được tự sập vòng hẹn giờ; lỗi đã ghi tệp chặn trong chayVong.
+        log(`[seller-lookup] loi-vong: ${e instanceof Error ? e.constructor.name : "unknown"}`);
+      })
+      .finally(() => {
+        dangChay = false;
+      });
+  }, chuKyMs);
+  vong.unref?.();
+  return () => {
+    dung = true;
+    clearInterval(vong);
+  };
+}
+
+// 0711-37(b): đủ MỌI hàm bắt buộc của LookupDeps (doiTen/tonTai/xoaFile từng thiếu).
+export function taoDepsMacDinh(dir: string, collectorUrl: string): LookupDeps {
+  return {
+    dir,
+    collectorUrl,
+    now: () => new Date(),
+    fetchImpl: fetch,
+    layApi: () => getConnectedZaloApi(),
+    treMs: (ms) => new Promise((r) => setTimeout(r, ms)),
+    docFile: async (p) => {
+      try {
+        return await fsp.readFile(p, "utf8");
+      } catch {
+        return null;
+      }
+    },
+    ghiFile: (p, d) => {
+      return fsp.writeFile(p, d, "utf8");
+    },
+    noiFile: (p, d) => {
+      return fsp.appendFile(p, d, "utf8");
+    },
+    doiTen: (a, b) => fsp.rename(a, b),
+    tonTai: async (p) => {
+      try {
+        await fsp.stat(p);
+        return true;
+      } catch {
+        return false;
+      }
+    },
+    xoaFile: (p) => fsp.unlink(p),
+  };
+}
+
+/** Móc monitor: đúng MỘT vòng hẹn giờ dù listener khởi động lại. */
+let boTraTimer: ReturnType<typeof setInterval> | undefined;
+
+// 0711-37(b): gọi ĐÚNG chayVong (tên cũ chayVongLookup không tồn tại); lỗi
+// được LOG (không nuốt lặng); trả hàm dừng để monitorTest dùng.
+export function khoiDongBoTra(
+  dir: string,
+  collectorUrl: string,
+  log: (line: string) => void,
+  chuKyMs = 60_000,
+  // S4-2(2)(3): mặc định dựng deps thật; test tiêm factory để đo cờ chống
+  // chồng + khuôn log mà không cần phiên kênh S03 thật.
+  taoDeps: (d: string, u: string) => LookupDeps = taoDepsMacDinh,
+): () => void {
+  if (boTraTimer) return () => {};
+  khoiDongBoTraDung = () => {
+    clearInterval(boTraTimer);
+    boTraTimer = undefined;
+  };
+  // S4-2(2): cờ đang-chạy như dungBoHenGio — vòng kéo quá chu kỳ không để
+  // vòng kế chạy song song (2 getUserInfo < 60s, demNgay ghi đè, spool ×2).
+  let dangChay = false;
+  boTraTimer = setInterval(() => {
+    if (dangChay) return;
+    dangChay = true;
+    void chayVong(taoDeps(dir, collectorUrl))
+      .then((v) => {
+        if (v.loi_goi > 0 || v.chan) {
+          // S4-2(3): KHÔNG log JSON nguyên v (có doi_chung[].ma) — chỉ số
+          // đếm + loai đối chứng + mã chặn, như dungBoHenGio.
+          log(
+            `[seller-lookup] loi_goi=${v.loi_goi} co-username=${v.dem["co-username"]} khong-username=${v.dem["khong-username"]} khong-ro=${v.dem["khong-ro"]} khong-tim-thay=${v.dem["khong-tim-thay"]}` +
+              (v.doi_chung.length ? ` doi_chung=${v.doi_chung.map((d) => d.loai).join(",")}` : "") +
+              (v.chan ? ` chan=${v.chan}` : ""),
+          );
+          if (v.chan === "listener-dong-sau-goi") {
+            log("[seller-lookup] dung-goi-Manh — listener đóng/lỗi sau lời gọi bộ tra");
+          }
+        }
+      })
+      .catch((e: unknown) => {
+        log(`[seller-lookup] loi-vong: ${e instanceof Error ? e.constructor.name : "unknown"}`);
+      })
+      .finally(() => {
+        dangChay = false;
+      });
+  }, chuKyMs);
+  boTraTimer.unref?.();
+  return khoiDongBoTraDung;
+}
+let khoiDongBoTraDung: (() => void) | null = null;
+
+// 0911-1 E1/E4: đếm vòng hẹn giờ bộ tra đang sống (0 hoặc 1) — cho ca kiểm
+// «Provider khởi hai lần vẫn đúng MỘT vòng» đo trên trạng thái thật.
+export function soVongHenGio(): number {
+  return boTraTimer ? 1 : 0;
+}
+
+// 0911-4(1): dừng vòng hẹn giờ ĐANG sống (bất kể lần khởi nào tạo ra) — cho
+// abort Provider: lần khởi idempotent trả hàm rỗng nên không dùng làm lối dừng.
+export function dungVongHienTai(): void {
+  if (boTraTimer) {
+    clearInterval(boTraTimer);
+    boTraTimer = undefined;
+  }
+}
+
+// 0711-37(b): điểm vào thật đọc S03_LOOKUP_DIR (bỏ trống = bộ tra tắt) và
+// S03_COLLECTOR_URL — runtime-map mô tả đúng cách vận hành.
+export function khoiDongTuEnv(log: (line: string) => void): () => void {
+  const dir = process.env.S03_LOOKUP_DIR?.trim();
+  if (!dir) return () => {};
+  return khoiDongBoTra(dir, process.env.S03_COLLECTOR_URL?.trim() ?? "", log);
+}
