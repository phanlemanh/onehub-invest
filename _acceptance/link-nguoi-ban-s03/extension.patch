+    await fs.ghiFile("/f/yeu-cau.json", JSON.stringify({ mas: ["7"], doi_chung: ["7"] }));
+    const v3 = await chayVong(deps);
+    expect(v3.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(2);
+  });
+
+  // MỞ LẠI 0611-6 (7) E2: ĐỦ loại lỗi máy chủ — mỗi lỗi dừng cả lượt với MÃ
