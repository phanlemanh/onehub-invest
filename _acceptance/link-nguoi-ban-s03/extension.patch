+
+  it("ngoài khung 01–05 giờ VN → 0 lời", async () => {
+    const { fs, api, deps } = chuanBi(9); // 09:30 VN — ngoài khung
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "2"]);
+    const v = await chayVong(deps);
+    expect(v.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(0);
+  });
+
+  it("collector không nhận → spool nối dần; PII canary KHÔNG xuất hiện ở bất kỳ đâu", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
+    const deps = taoDeps(undefined, fs, 2, false); // collector fail
+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "2"]);
+    await chayVong(deps);
+    const spool = fs.files.get("/f/spool-ho-so.jsonl") ?? "";
+    expect(spool).toContain("\"loai\":\"co-username\""); // dòng spool mang loai kết quả từng mã
+    expect(spool).not.toContain(PII.canary);
+  });
+
+  it("AC-4: lời gọi API MỚI duy nhất là getUserInfo — các hàm cấm 0 lần", async () => {
+    const { fs, api, deps } = chuanBi();
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "2"]);
