+import { describe, expect, it, vi } from "vitest";
+// link-nguoi-ban-s03 AC-4: kiểm tĩnh + chạy với API GIÃ có bẫy đếm lời gọi.
+// Không mock withS03Api (chỗ thế S03) bằng cách gọi nó — bộ tra KHÔNG được import/dùng nó;
+// API giả ở đây có đủ các hàm cấm (login/createS03/requestOldMessages…)
+// gắn spy để khẳng định không bao giờ được gọi.
+
+import { chayVong, phanLoai, trongKhung, boHauSo, TRAN, type LookupDeps } from "./seller-lookup.js";
+
+// Chuỗi đánh dấu PII (AC-5): API giả nhét vào tên/SĐT/ảnh/ngày sinh + giá trị
+// dạng cookie — phải KHÔNG bao giờ xuất hiện trong snapshot/spool/tệp chặn.
+const PII = {
+  ten: "TEN_CAN_DAI__canary",
+  sdt: "SDT_CAN_DAI__canary",
+  anh: "ANH_CAN_DAI__canary",
+  sinh: "SINH_CAN_DAI__canary",
+  loi: "LOI_THO_CAN_DAI__canary",
+  cookie: "zpw_en=__CANARY_COOKIE__",
+};
+
+type FsFake = {
+  files: Map<string, string>;
+};
+
+function taoFsFake(): FsFake & Pick<LookupDeps, "docFile" | "ghiFile" | "noiFile" | "doiTen" | "tonTai" | "xoaFile"> {
+  const files = new Map<string, string>();
+  return {
+    files,
+    docFile: async (p) => files.get(p) ?? null,
+    ghiFile: async (p, d) => {
+      files.set(p, d);
+    },
+    noiFile: async (p, d) => {
+      files.set(p, (files.get(p) ?? "") + d);
+    },
+    doiTen: async (a, b) => {
+      const v = files.get(a);
+      files.delete(a);
+      if (v !== undefined) files.set(b, v);
+    },
+    tonTai: async (p) => files.has(p),
+    xoaFile: async (p) => {
+      files.delete(p);
+    },
+  };
+}
+
+type ApiGia = {
+  dem: { getUserInfo: number };
+  voi: number[]; // số mã mỗi lời
+  lanSai?: (lan: number) => never;
+  ketQuaThe: (mas: string[]) => unknown;
+  login: ReturnType<typeof vi.fn>;
+  loginQR: ReturnType<typeof vi.fn>;
+  createZalo: ReturnType<typeof vi.fn>;
+  requestOldMessages: ReturnType<typeof vi.fn>;
+  sendZaloTextMessage: ReturnType<typeof vi.fn>;
+};
+
+function taoApiGia(): ApiGia {
+  return {
+    dem: { getUserInfo: 0 },
+    voi: [],
+    ketQuaThe: (mas) => ({
+      changed_profiles: Object.fromEntries(
+        mas.slice(0, 2).map((m, i) => [
+          `${m}_0`,
+          {
+            userId: m,
+            username: `user_${m}`,
+            displayName: PII.ten,
+            phoneNumber: PII.sdt,
+            avatar: PII.anh,
+            dob: PII.sinh,
+            userKey: PII.cookie,
+          },
+        ]),
+      ),
+      unchanged_profiles: Object.fromEntries(
+        mas.slice(2, 3).map((m) => [`${m}_0`, { isFr: 0 }]),
+      ),
+      phonebook_version: 1,
+    }),
+    login: vi.fn(),
+    loginQR: vi.fn(),
+    createZalo: vi.fn(),
+    requestOldMessages: vi.fn(),
+    sendZaloTextMessage: vi.fn(),
+  };
+}
+
+function taoDeps(
+  _apiGia: ApiGia | undefined,
+  fsFake: ReturnType<typeof taoFsFake>,
+  gioVN: number,
+  collectorOk = true,
+): LookupDeps & { spoolText(): string } {
+  // Giờ VN điều khiển bằng tham số: dựng now sao cho giờ VN (UTC+7) = gioVN.
+  const now = new Date(Date.UTC(2026, 10, 8, gioVN - 7, 30, 0));
+  return {
+    dir: "/f",
+    collectorUrl: "http://collector.test/s03",
+    now: () => now,
+    treMs: (ms?: number) => new Promise((r) => setTimeout(r, ms ?? 0)),
+    layApi: () => undefined, // mỗi test gắn lại bằng API giả riêng
+    fetchImpl: (async () => ({ ok: collectorOk }) as unknown as Response) as unknown as typeof fetch,
+    docFile: fsFake.docFile,
+    ghiFile: fsFake.ghiFile,
+    noiFile: fsFake.noiFile,
+    doiTen: fsFake.doiTen,
+    tonTai: fsFake.tonTai,
+    xoaFile: fsFake.xoaFile,
+    spoolText: () => fsFake.files.get("/f/spool-ho-so.jsonl") ?? "",
+  };
+}
+
+// Wrapper gọn: api giả có dem + các hàm cấm; getUserInfo bẫy đếm.
+function gắnApiGia(apiGia: ApiGia) {
+  return {
+    getUserInfo: async (uids: string[] | string) => {
+      apiGia.dem.getUserInfo++;
+      const mas = Array.isArray(uids) ? uids : [uids];
+      apiGia.voi.push(mas.length);
+      if (apiGia.lanSai) return apiGia.lanSai(apiGia.dem.getUserInfo);
+      return apiGia.ketQuaThe(mas);
+    },
+    login: apiGia.login,
+    loginQR: apiGia.loginQR,
+    createZalo: apiGia.createZalo,
+    requestOldMessages: apiGia.requestOldMessages,
+    sendZaloTextMessage: apiGia.sendZaloTextMessage,
+  };
+}
+
+describe("link-nguoi-ban-s03 — phanLoai (AC-1)", () => {
+  it("_0 được bóc khi khớp; 4 loại phân đúng; chỉ giữ userId+username", () => {
+    const kq = phanLoai(
+      {
+        changed_profiles: {
+          "111_0": { userId: "111", username: "u111" },
+          "222_0": { userId: "222" },
+        },
+        unchanged_profiles: { "333_0": { isFr: 0 } },
+      },
+      ["111", "222", "333", "444"],
+    );
+    expect(kq).toEqual([
+      { ma: "111", loai: "co-username", username: "u111" },
+      { ma: "222", loai: "khong-username", username: "" },
+      { ma: "333", loai: "khong-ro", username: "" },
+      { ma: "444", loai: "khong-tim-thay", username: "" },
+    ]);
+  });
+
+  it("userId trả về khác mã gửi → khong-ro (khác không gian mã)", () => {
+    const kq = phanLoai({ changed_profiles: { "111_0": { userId: "999", username: "x" } } }, ["111"]);
+    expect(kq[0].loai).toBe("khong-ro");
+  });
+
+  it("trongKhung đúng khung 01–05 giờ VN; boHauSo cắt _0", () => {
+    expect(trongKhung(new Date(Date.UTC(2026, 10, 8, 18, 30, 0)))).toBe(true); // 01:30 VN
+    expect(trongKhung(new Date(Date.UTC(2026, 10, 8, 22, 0, 0)))).toBe(false); // 05:00 VN
+    expect(boHauSo("123_0")).toBe("123");
+    expect(boHauSo("123")).toBe("123");
+    expect(TRAN.maMoiLoi).toBe(20);
+  });
+});
+
+describe("link-nguoi-ban-s03 — chayVong với API giả (AC-1..AC-4)", () => {
+  function chuanBi(gio = 2) {
+    const fs = taoFsFake();
+    const api = taoApiGia();
