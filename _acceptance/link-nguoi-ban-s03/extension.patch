+
 export async function monitorZalouserProvider(
   options: ZalouserMonitorOptions,
 ): Promise<ZalouserMonitorResult> {
+  // link-nguoi-ban-s03 (b): MỘT vòng hẹn giờ bộ tra hồ sơ — khởi ở ĐẦU đường
+  // khởi động Provider; idempotent: Provider khởi lại (listener reconnect)
+  // vẫn đúng MỘT vòng (AC-1, E1/E4 siết 0911). Đọc S03_LOOKUP_DIR (rỗng = tắt).
+  const dungBoTra = khoiDongTuEnv((line) => {
+    options.runtime?.log?.(line);
+  });
+  // 0911-4(1): Provider bị huỷ (abort) mà gateway còn sống thì bộ tra phải dừng
+  // theo — «tắt là dừng» của an toàn S03; idempotent nên khởi lại vẫn đúng 1 vòng.
+  options.abortSignal?.addEventListener(
+    "abort",
+    () => {
+      dungBoTra();
+      dungVongHienTai();
+    },
+    { once: true },
+  );
   const { config } = options;
   let { account } = options;
   const { abortSignal, statusSink, runtime } = options;
