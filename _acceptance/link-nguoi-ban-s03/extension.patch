+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    return { fs, api, deps };
+  }
+  const ghiYeuCau = (fs: FsFake, mas: string[], doiChung: string[]) =>
+    fs.ghiFile("/f/yeu-cau.json", JSON.stringify({ mas, doi_chung: doiChung }));
+
+  it("không có tệp yêu cầu → 0 lời gọi, không tệp chặn", async () => {
+    const { api, deps } = chuanBi();
