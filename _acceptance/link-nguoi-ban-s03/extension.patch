+
+  // MỞ LẠI claudedp-0611-35 ca (b): doi_chung không toàn chữ số →
+  // chan sai-khuon-yeu-cau, 0 lời, không ghi da-thu
+  it("doi_chung có chữ → chan sai-khuon-yeu-cau, 0 lời, không ghi da-thu", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
+    const deps = taoDeps(undefined, fs, 2);
+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    await ghiYeuCau(fs, ["1", "2", "3"], ["90a", "902"]);
+    const v = await chayVong(deps);
+    expect(v.chan).toBe("sai-khuon-yeu-cau");
+    expect(await fs.docFile("/f/chan.txt")).toBe("sai-khuon-yeu-cau");
+    expect(api.dem.getUserInfo).toBe(0);
+    expect(await fs.tonTai("/f/da-thu.txt")).toBe(false);
+  });
+
+  it("đặt tệp chặn giữa lượt (trước lời) → 0 lời và KHÔNG đốt dấu đã-thu", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
+    const deps = taoDeps(undefined, fs, 2);
+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "2"]);
+    await fs.ghiFile("/f/chan.txt", "nguoi-dat-thu");
+    const v = await chayVong(deps);
+    expect(v.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(0);
+    expect(await deps.tonTai("/f/da-thu.txt")).toBe(false);
