+    expect(v.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(0);
+    expect(await deps.tonTai("/f/chan.txt")).toBe(false);
+  });
+
+  it("không có phiên (listener chết) → tệp chặn khong-co-phien, 0 lời, 0 login", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
+    const deps = taoDeps(undefined, fs, 2);
+    (deps as unknown as { layApi: unknown }).layApi = () => undefined;
+    await ghiYeuCau(fs, ["1"], ["1"]);
+    const v = await chayVong(deps);
+    expect(v.chan).toBe("khong-co-phien");
+    expect(api.dem.getUserInfo).toBe(0);
+    expect(api.login).not.toHaveBeenCalled();
+    expect(api.createZalo).not.toHaveBeenCalled();
+  });
+
+  it("lượt thử: đúng 1 lời ≤20 mã + dấu đã-thu; chạy lại 0 lời; tệp đổi tên đã-xử", async () => {
+    const { fs, api, deps } = chuanBi();
+    const mas = Array.from({ length: 25 }, (_, i) => String(100 + i)); // 25 mã → trần 20
+    await ghiYeuCau(fs, mas, mas.slice(0, 2));
+    const v1 = await chayVong(deps);
+    expect(v1.loi_goi).toBe(1);
+    expect(api.dem.getUserInfo).toBe(1);
+    expect(api.voi[0]).toBe(TRAN.maMoiLoi); // đúng 20 mã trong lời
+    expect(v1.dem["co-username"]).toBe(2);
+    expect(v1.dem["khong-ro"]).toBe(1);
+    expect(v1.dem["khong-tim-thay"]).toBe(17);
+    expect(await deps.tonTai("/f/da-thu.txt")).toBe(true);
+    expect(await deps.tonTai("/f/yeu-cau.da-xu.json")).toBe(true);
+    expect(await deps.tonTai("/f/yeu-cau.json")).toBe(false);
+    // tệp yêu cầu MỚI xuất hiện nhưng dấu đã-thu còn → 0 lời (chế độ thử)
+    await ghiYeuCau(fs, ["5", "6"], ["5", "6"]);
+    const v2 = await chayVong(deps);
+    expect(v2.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(1);
+  });
+
+  it("mốc 60 giây sống qua 'khởi động lại': vòng 2 ngay sau → 0 lời", async () => {
+    const { fs, api, deps } = chuanBi();
+    await fs.ghiFile("/f/yeu-cau.json", JSON.stringify({ mas: ["1", "2", "3"], doi_chung: ["1", "2"] }));
+    await chayVong(deps);
+    // mô phỏng khởi động lại: deps MỚI (mốc nằm trên đĩa chung fs)
+    const deps2 = { ...deps, layApi: () => gắnApiGia(api) };
+    const v = await chayVong(deps2 as LookupDeps);
+    expect(v.loi_goi).toBe(0);
+    expect(api.dem.getUserInfo).toBe(1);
+  });
+
+  it("lỗi HTTP 429 → dừng cả lượt, tệp chặn chỉ mã+số (không thông điệp thô), không thử lại", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
+    api.lanSai = () => {
+      throw new Error(`HTTP 429: ${PII.loi}`);
+    };
+    const deps = taoDeps(undefined, fs, 2);
+    (deps as unknown as { layApi: unknown }).layApi = () => gắnApiGia(api);
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "2"]);
+    const v = await chayVong(deps);
+    expect(v.chan).toBe("http-429");
+    const chan = await fs.docFile("/f/chan.txt");
+    expect(chan).toBe("http-429 429");
+    expect(chan).not.toContain(PII.loi);
+    // tệp chặn còn → 0 lời mãi tới khi xoá
+    await chayVong(deps);
+    expect(api.dem.getUserInfo).toBe(1);
+  });
+
+  it("đối chứng ra khong-tim-thay → tệp chặn khac-khong-gian-ma", async () => {
+    const { fs, api, deps } = chuanBi();
+    await ghiYeuCau(fs, ["1", "2", "3"], ["1", "444"]); // 444 không có trong trả về
+    const v = await chayVong(deps);
+    expect(v.chan).toBe("khac-khong-gian-ma");
+    expect(await fs.docFile("/f/chan.txt")).toBe("khac-khong-gian-ma");
+    expect(api.dem.getUserInfo).toBe(1);
+  });
+
+  // MỞ LẠI claudedp-0611-35 ca (a): mas 20 + doi_chung 2 NGOÀI mas → đúng
+  // 1 lời 22 mã, không chặn, dòng gửi collector chỉ 20 mã mas
+  it("mas 20 + doi_chung 2 ngoài mas → 1 lời 22 mã, không chặn, collector chỉ 20 dòng", async () => {
+    const fs = taoFsFake();
+    const api = taoApiGia();
