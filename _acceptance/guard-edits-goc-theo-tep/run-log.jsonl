"{\"ts\":\"2026-11-02T23:16:18Z\",\"sha\":\"16bfd9f3bfa660f662ec9b0970f427059ca821f5\",\"round\":1,\"kind\":\"finding\",\"file\":\"_acceptance/guard-edits-goc-theo-tep/evals.yaml\",\"title\":\"Hình dạng 4 — Assertion âm tính một mình: E3/E4 khai chiều đỏ do E6 đo, nhưng ba dòng exit 0 không có đột biến ghim\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Ba trường hợp rào phải để cho sửa tệp đi qua chưa có phép thử cố tình làm hỏng để chứng minh bộ kiểm sẽ báo đỏ nếu rào chặn nhầm. Rào hiện vẫn cho qua đúng.\",\"can_cu\":\"Rào đang chạy đúng nên người dùng không bị chặn nhầm; chỉ là bằng chứng bộ kiểm biết báo lỗi còn mỏng ở vài ca, sửa sau cũng không muộn.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-02T23:16:18Z\",\"sha\":\"16bfd9f3bfa660f662ec9b0970f427059ca821f5\",\"round\":1,\"kind\":\"finding\",\"file\":\"_acceptance/guard-edits-goc-theo-tep/probes/dot-bien.sh\",\"title\":\"Hình dạng 4 — Assertion âm tính một mình: «không còn ref tạm» không thể đỏ, các dòng dọn dẹp AC-8 không có đối chứng dương\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Phép kiểm xác nhận không còn nhánh tạm sau khi chạy thử có thể không bao giờ báo đỏ, nên nếu sau này có rò rỉ thật thì chưa chắc phát hiện. Hiện chưa thấy rò rỉ nào.\",\"can_cu\":\"Không có hại thực tế đã xảy ra và nếu rò thì chỉ để lại rác tạm trong kho, người dùng tự dọn được; củng cố phép đo là việc tốt nhưng không gấp.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-02T23:16:18Z\",\"sha\":\"16bfd9f3bfa660f662ec9b0970f427059ca821f5\",\"round\":1,\"kind\":\"finding\",\"file\":\".claude/hooks/tests/guard-edits.selftest.sh\",\"title\":\"Hình dạng 5 — Tuyên lớp nhưng chỉ có điểm-case: AC-1 nêu tổ hợp 2×2×2, selftest có bốn ca và không có ma trận\",\"severity\":\"low\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bộ kiểm chỉ thử bốn trong tám cách kết hợp sửa tệp ở worktree khác, nên vài cách hiếm chưa được kiểm tự động. Chưa có dấu hiệu rào chạy sai ở các cách đó.\",\"can_cu\":\"Rủi ro thấp vì các cách chưa thử dùng chung đường xử lý với cách đã thử, và nếu sai thì rào chỉ để lọt chứ không làm mất dữ liệu ngay.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-02T23:16:18Z\",\"sha\":\"16bfd9f3bfa660f662ec9b0970f427059ca821f5\",\"round\":1,\"kind\":\"finding\",\"file\":\".claude/hooks/tests/guard-edits.selftest.sh\",\"title\":\"Hình dạng 5 — Tuyên lớp nhưng chỉ có điểm-case: «kho git khác» chỉ ghim 2 trong 3 luật\",\"severity\":\"low\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Hành vi của rào với thư mục hồ sơ AirDNA ở kho git khác chưa được bộ kiểm giữ lại, nên đổi hành vi này sau này sẽ không ai bị báo. Hiện rào vẫn chặn đúng.\",\"can_cu\":\"Hiện không ảnh hưởng ai và rào đang đúng; chỉ là một thay đổi tương lai có thể lặng lẽ đổi hành vi mà không bị bắt.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
