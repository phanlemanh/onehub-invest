"{\"ts\":\"2026-11-26T21:33:37Z\",\"sha\":\"4a35f80dd3b4d26780f75d8e795fb3bc9d2c677b\",\"round\":1,\"kind\":\"finding\",\"file\":\"app/tests/registry-s08-luat.test.tsx\",\"title\":\"RS8 làm đỏ suite app ở máy: before() đòi DB tên oneinvest_suite_rs8 trong khi npm test của app cấp oneinvest_suite_app_<pid>\",\"severity\":\"high\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Khi chạy bộ kiểm của ứng dụng trên máy thu hoặc M5, có thêm một ca báo đỏ dù tính năng không hỏng. Trên hệ thống kiểm tự động thì ca này được bỏ qua nên không ai thấy.\",\"can_cu\":\"Không ảnh hưởng dữ liệu hay người dùng cuối, chỉ gây báo đỏ giả cho người vận hành; sửa sau rẻ và tách được thành việc nhỏ riêng.\",\"proposal\":\"new-contract\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-26T21:33:37Z\",\"sha\":\"4a35f80dd3b4d26780f75d8e795fb3bc9d2c677b\",\"round\":1,\"kind\":\"finding\",\"file\":\"pipeline/lib/noi-du-an-s08-lop.mjs\",\"title\":\"A later apply run creates a second candidate node for a group that the S08 rule already cast\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu sau này thêm một dự án S08 cùng tên gốc với dự án đã có nút, danh bạ có thể tạo thêm một nút thứ hai cùng tên thay vì gộp vào nút cũ. Hai dự án cùng nhóm khi đó nằm ở hai nút riêng.\",\"can_cu\":\"Chỉ sinh nút ứng viên dư, không mất hay lộ dữ liệu và đảo được theo mã lượt; hôm nay chưa có ca thật nên chấp nhận và ghi lại là đủ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
